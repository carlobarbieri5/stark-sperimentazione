# Rust build output
/target

# data/ is tracked (raw data); paper/ tracks the LaTeX source and figures (only the compiled
# PDF is kept local); docs/ tracks the provenance/reproducibility notes. Artifacts ignored below.
/.archive/

# Publish the thesis LaTeX source; keep only the compiled PDF local.
/paper/*.pdf

# Internal methods report kept local (superseded by docs/REPRODUCIBILITY.md).
/docs/REPORT.md

# Local editor / assistant config
/.claude/

# LaTeX build artifacts (safety net; paper/ is already ignored)
*.aux
*.log
*.out
*.dat
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# OS cruft
Thumbs.db
.DS_Store
